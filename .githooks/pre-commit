#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
git_dir=$(git rev-parse --git-dir)

[ -f "$git_dir/MERGE_HEAD" ] && exit 0
[ -d "$git_dir/rebase-merge" ] && exit 0
[ -d "$git_dir/rebase-apply" ] && exit 0

bump() {
  major=${1%%.*}
  rest=${1#*.}
  minor=${rest%%.*}
  patch=${rest#*.}
  echo "$major.$minor.$((patch + 1))"
}

bump_compose() {
  file=$1
  [ -f "$file" ] || return 0
  old=$(sed -n 's|^[[:space:]]*image: .*:\([0-9][0-9.]*\)[[:space:]]*$|\1|p' "$file" | head -1)
  [ -n "$old" ] || return 0
  sed -i -E "s|^([[:space:]]*image: .*):$old\$|\1:$(bump "$old")|" "$file"
  git add "$file"
}

bump_package() {
  file=$1
  [ -f "$file" ] || return 0
  old=$(sed -n 's|^[[:space:]]*"version": "\([0-9][0-9.]*\)".*|\1|p' "$file" | head -1)
  [ -n "$old" ] || return 0
  sed -i -E "s|\"version\": \"$old\"|\"version\": \"$(bump "$old")\"|" "$file"
  git add "$file"
}

staged=$(git diff --cached --name-only)
for compose in */compose.yaml; do
  [ -f "$compose" ] || continue
  app=${compose%/compose.yaml}
  if echo "$staged" | grep -Eq "^$app/"; then
    bump_compose "$compose"
    bump_package "$app/package.json"
  fi
done
